# 환경변수 설정 예제
# .env 파일을 생성하고 아래 내용을 복사한 후 값을 수정하세요
# Vercel 배포 시에는 Vercel Dashboard에서 환경변수로 설정하세요!

# ============================================================================
# Flask 설정 (필수)
# ============================================================================
FLASK_SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
FLASK_ENV=production
PORT=5000

# ============================================================================
# 데이터베이스 (택일) - Vercel에서는 Supabase 권장!
# ============================================================================
# 옵션 1: SQLite (로컬 개발용만 - Vercel에서는 사용 불가!)
# DATABASE_URL=sqlite:///cgv_alert.db

# 옵션 2: Supabase PostgreSQL (Vercel 배포 시 권장 ⭐)
# Supabase 프로젝트 생성 후 Connection Pooling URL 사용
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 옵션 3: 다른 PostgreSQL (Heroku, Railway 등)
# DATABASE_URL=postgresql://user:password@host:port/database

# ============================================================================
# 이메일 알림 설정 (Gmail 권장)
# ============================================================================
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-gmail-app-password

# Gmail 앱 비밀번호 생성 방법:
# 1. Google 계정 설정 (https://myaccount.google.com)
# 2. 보안 → 2단계 인증 활성화
# 3. 앱 비밀번호 생성 (메일 선택)
# 4. 생성된 16자리 비밀번호 사용 (공백 없이)

# ============================================================================
# 크롤러 설정
# ============================================================================
# Mock 크롤러 사용 여부 (테스트용)
USE_MOCK_CRAWLER=True
# 실제 CGV 크롤링하려면 False로 변경
# 주의: CGV 봇 정책 준수 필요! (robots.txt, Rate Limiting)

# ============================================================================
# 선택사항: Telegram 봇 알림
# ============================================================================
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=your-chat-id

# Telegram 봇 생성 방법:
# 1. Telegram에서 @BotFather 검색
# 2. /newbot 명령어로 봇 생성
# 3. Bot Token 복사
# 4. 본인 Chat ID 확인 (@userinfobot 사용)

# ============================================================================
# 선택사항: Discord Webhook 알림
# ============================================================================
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Discord Webhook 생성 방법:
# 1. Discord 서버 설정 → 연동 → 웹후크
# 2. 웹후크 생성 및 URL 복사

# ============================================================================
# 초기 관리자 계정 (첫 실행 시 자동 생성)
# ============================================================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-immediately

# ============================================================================
# Vercel 전용 설정 (Vercel 배포 시 필수)
# ============================================================================
# Cron Job 보안을 위한 secret (랜덤 문자열 생성 권장)
CRON_SECRET=your-random-secret-for-cron-security

# Cron Secret 생성 방법 (터미널에서 실행):
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# ============================================================================
# Vercel 환경변수 설정 방법
# ============================================================================
# 1. Vercel Dashboard → 프로젝트 선택
# 2. Settings → Environment Variables
# 3. 위의 모든 환경변수를 하나씩 추가
# 4. Production, Preview, Development 환경 모두 체크
# 5. Save 클릭

# 중요: .env 파일은 절대 GitHub에 커밋하지 마세요!
# .gitignore에 .env가 포함되어 있는지 확인하세요!
