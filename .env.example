# 환경변수 설정 예제
# .env 파일을 생성하고 아래 내용을 복사한 후 값을 수정하세요

# Flask 설정
FLASK_SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
FLASK_ENV=development
FLASK_DEBUG=True

# 데이터베이스 (택일)
# 옵션 1: SQLite (로컬 개발용 - 설정 필요 없음)
DATABASE_URL=sqlite:///cgv_alert.db

# 옵션 2: Supabase PostgreSQL (권장)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 옵션 3: 로컬 PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/cgv_alert

# 이메일 설정 (Gmail)
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-gmail-app-password

# Gmail 앱 비밀번호 생성 방법:
# 1. Google 계정 설정 (myaccount.google.com)
# 2. 보안 → 2단계 인증 활성화
# 3. 앱 비밀번호 생성
# 4. 생성된 16자리 비밀번호 사용

# 크롤러 설정
USE_MOCK_CRAWLER=True
# 실제 CGV 크롤링하려면 False로 변경 (주의: CGV 봇 정책 준수)

# 선택사항: Telegram 봇
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=your-chat-id

# 선택사항: Discord Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 초기 관리자 계정 (첫 실행 시 자동 생성)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-immediately
