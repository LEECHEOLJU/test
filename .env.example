# ============================================================================
# CGV IMAX 예매 알림 시스템 - 환경변수 설정
# ============================================================================
#
# 이 파일을 복사하여 .env 파일을 생성하고 값을 수정하세요
# Vercel 배포 시에는 Vercel Dashboard → Settings → Environment Variables에서 설정
#
# ============================================================================

# ============================================================================
# 📌 필수 환경변수 (6개) - 반드시 설정해야 합니다!
# ============================================================================

# 1. Flask Secret Key (필수 ⭐)
# 용도: 사용자 로그인 세션 암호화에 사용 (Flask-Login)
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 예시: AbCdEf1234567890XyZaBcDeFgHiJkLmNoPqRsTuVwXyZ-12345678
FLASK_SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# 2. 데이터베이스 URL (필수 ⭐)
# 용도: 영화 정보, 사용자 정보, 알림 히스토리 저장
# Supabase 무료 사용: SUPABASE_SETUP_GUIDE.md 참조
#
# Supabase Connection Pooling URL 형식 (Transaction 모드):
# postgresql://postgres.[프로젝트ID]:[비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
#
# ⚠️ Vercel에서는 SQLite 사용 불가! (파일 시스템 제한)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 로컬 테스트용 SQLite (Vercel 배포 시 사용 불가):
# DATABASE_URL=sqlite:///cgv_alert.db

# 3. Gmail 이메일 주소 (필수 ⭐)
# 용도: 예매 오픈 알림 이메일 발신자
# 예시: myemail@gmail.com
SENDER_EMAIL=your-email@gmail.com

# 4. Gmail 앱 비밀번호 (필수 ⭐)
# 용도: Gmail SMTP 인증 (일반 비밀번호 아님!)
# 생성 방법:
#   1. https://myaccount.google.com/security 접속
#   2. "2단계 인증" 활성화 (필수!)
#   3. 검색창에 "앱 비밀번호" 검색
#   4. 앱 선택: 메일, 기기: 기타 (CGV Alert 입력)
#   5. 생성된 16자리 비밀번호 복사 (공백 제거)
# 예시: abcdefghijklmnop (16자리, 공백 없음)
SENDER_PASSWORD=your-gmail-app-password

# ⚠️ 주의: Gmail 일반 비밀번호가 아닌 "앱 비밀번호"를 사용해야 합니다!
# ⚠️ 2단계 인증이 활성화되어 있어야 앱 비밀번호 생성 가능합니다!

# 5. 관리자 비밀번호 (필수 ⭐)
# 용도: 웹 대시보드 로그인 비밀번호 (username: admin)
# 보안: 강력한 비밀번호 사용 권장 (영문 대소문자+숫자+특수문자)
# 예시: MySecureP@ssw0rd!2024
ADMIN_PASSWORD=change-this-password-immediately

# 6. CGV 크롤링 모드 (필수 ⭐)
# 용도: 실제 CGV 크롤링 or 테스트 Mock 데이터
# 값:
#   - True: Mock 모드 (가짜 데이터, 테스트용)
#   - False: 실제 CGV 크롤링 (예매 오픈 감지)
#
# ⚠️ 실제 사용 시 False로 설정!
# ⚠️ CGV 봇 정책 준수 (Rate Limiting 자동 적용됨)
USE_MOCK_CRAWLER=True

# ============================================================================
# 📱 추가 알림 채널 (선택 - 이메일만으로도 충분합니다)
# ============================================================================

# Telegram 봇 알림 (선택)
# 용도: Telegram으로도 알림 받기 (이메일 + Telegram)
# 생성 방법:
#   1. Telegram 앱에서 @BotFather 검색
#   2. /newbot 명령어 입력
#   3. 봇 이름 및 Username 설정
#   4. Bot Token 복사
#   5. @userinfobot에서 본인 Chat ID 확인
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789

# Discord Webhook 알림 (선택)
# 용도: Discord로도 알림 받기 (이메일 + Discord)
# 생성 방법:
#   1. Discord 서버 설정 → 연동
#   2. 웹후크 → 새 웹후크 생성
#   3. 웹후크 URL 복사
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ============================================================================
# 🔧 선택 환경변수 (권장하지만 필수는 아님)
# ============================================================================

# Vercel Cron Job 보안 키 (선택, 권장 ⭐)
# 용도: 외부에서 /api/cron/monitor를 무단 호출하는 것을 방지
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 설정하지 않으면: 누구나 /api/cron/monitor를 호출 가능 (보안 취약)
# 설정하면: Vercel Cron만 호출 가능 (보안 강화)
# 예시: aB3dE5fG7hI9jK1lM3nO5pQ7rS9tU1vW3xY5zA7bC9dE
# CRON_SECRET=your-random-secret-for-cron-security

# ⚠️ 프로덕션 환경에서는 설정 권장!

# ============================================================================
# 📝 Vercel 환경변수 설정 방법
# ============================================================================
#
# Vercel에서 배포 시:
# 1. Vercel Dashboard 접속
# 2. 프로젝트 선택
# 3. Settings 탭 → Environment Variables 메뉴
# 4. 위의 필수 환경변수 6개를 하나씩 추가:
#    - Name (이름): 환경변수 이름 (예: FLASK_SECRET_KEY)
#    - Value (값): 실제 값
#    - Environment: Production, Preview, Development 모두 체크 ✅
# 5. Add 버튼 클릭
# 6. 모든 환경변수 입력 완료 후 Redeploy
#
# 로컬 테스트 시:
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. .env 파일 열어서 값 수정
# 3. python app.py 실행
#
# ⚠️ 보안 주의사항:
# - .env 파일은 절대 GitHub에 커밋하지 마세요!
# - .gitignore에 .env가 포함되어 있는지 확인하세요!
# - 환경변수 값을 다른 사람과 공유하지 마세요!
#
# ============================================================================

# ============================================================================
# 📊 환경변수 요약
# ============================================================================
#
# 필수 (6개):
#   1. FLASK_SECRET_KEY      - Flask 세션 암호화 키
#   2. DATABASE_URL          - Supabase PostgreSQL URL
#   3. SENDER_EMAIL          - Gmail 주소
#   4. SENDER_PASSWORD       - Gmail 앱 비밀번호
#   5. ADMIN_PASSWORD        - 관리자 로그인 비밀번호
#   6. USE_MOCK_CRAWLER      - True (테스트) / False (실제)
#
# 권장 (1개):
#   7. CRON_SECRET           - Vercel Cron 보안 키
#
# 선택 (2개):
#   8. TELEGRAM_BOT_TOKEN    - 텔레그램 알림용
#   9. DISCORD_WEBHOOK_URL   - 디스코드 알림용
#
# ============================================================================
